<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Contratação de Hospedagem">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Data de Entrada" />
            <DatePicker x:Name="DateEntrada" />

            <Label Text="Data de Saída" />
            <DatePicker x:Name="DateSaida" />

            <Label Text="Adultos" />
            <Entry x:Name="EntryAdultos" Keyboard="Numeric" Placeholder="Número de adultos" />

            <Label Text="Crianças" />
            <Entry x:Name="EntryCriancas" Keyboard="Numeric" Placeholder="Número de crianças" />

            <Button Text="Próximo" Clicked="OnProximoClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>